DATABASE_URL=sqlite:///../agentforge.db
CORS_ORIGINS=http://localhost:5173
SANDBOX_TIMEOUT_SECONDS=30
# Optional provider keys. Keep these server-side and never expose them to the frontend.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GitHub draft PR creation and merge. Fine-grained token needs Contents and Pull requests read/write.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=jems0906/AgentForge-SDLC
# GITHUB_BASE_BRANCH=main
# Railway Sandbox, deployment, and rollback API token (environment-scoped project token).
# RAILWAY_PROJECT_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_ENVIRONMENT_ID=
# RAILWAY_SERVICE_ID=
